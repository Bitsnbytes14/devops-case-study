[Unit]
Description=RoomFit allocation service
After=network.target
[Service]
User=roomfit
Group=roomfit
EnvironmentFile=/etc/roomfit/roomfit.env
WorkingDirectory=/opt/roomfit
ExecStart=/opt/roomfit/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 1 --threads 4 --access-logfile - app.main:app
Restart=always
[Install]
WantedBy=multi-user.target
